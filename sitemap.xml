---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
{% for post in site.posts %}
{% unless post.canonical_url %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
    {% assign article_modified = post.last_modified_at | default: post.date | date: '%s' | plus: 0 %}
    {% assign price_file = post.path | split: '/' | last %}
    {% assign observations = site.data.verified_prices[price_file] %}
    {% if observations %}{% assign table_modified = observations.day | date: '%s' | plus: 0 %}{% assign article_modified = article_modified | at_least: table_modified %}{% endif %}
    <lastmod>{{ article_modified | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
{% endunless %}
{% endfor %}
{% for cat_hash in site.categories %}
{% assign latest_update = 0 %}
{% for post in cat_hash[1] %}{% unless post.canonical_url %}
{% assign updated = post.last_modified_at | default: post.date | date: '%s' | plus: 0 %}
{% if updated > latest_update %}{% assign latest_update = updated %}{% endif %}
{% endunless %}{% endfor %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/category/{{ cat_hash[0] }}/</loc>
    <lastmod>{{ latest_update | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
{% endfor %}
{% for page in site.pages %}
  {% if page.sitemap != false and page.name != '404.html' %}
    {% if page.url == '/about' or page.url == '/all/' or page.url == '/categories/' or page.discovery_page == true %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ page.url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
    {% endif %}
  {% endif %}
{% endfor %}
</urlset>
